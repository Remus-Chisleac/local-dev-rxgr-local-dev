                <option value="">{{ 'aico_preorder.filters.billing_placeholder' | t }}</option>
                {% for address in aico_preorder.billing_addresses %}
                  <option value="{{ address.id }}">{{ address.label }}</option>
                {% endfor %}
              </select>
              <button type="button"
                      id="aico-preorder2-billing-trigger"
                      class="aico-preorder2-custom-select-trigger"
                      data-aico-custom-select-trigger
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-labelledby="aico-preorder2-billing-label"
                      {% if aico_preorder.billing_addresses == empty %}disabled{% endif %}>
                <span class="aico-preorder2-custom-select-label" data-aico-custom-select-label></span>
                <svg class="aico-preorder2-custom-select-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="aico-preorder2-custom-select-dropdown" data-aico-custom-select-dropdown hidden>
                <div role="listbox" class="aico-preorder2-custom-select-list" data-aico-custom-select-list></div>
              </div>
            </div>
          </div>
        </div>

        <div class="aico-preorder2-field" data-aico-field="delivery_address">
          <span id="aico-preorder2-delivery-label" class="aico-preorder2-field-label">{{ 'aico_preorder.filters.delivery_label' | t }}</span>
          <div class="aico-preorder2-field-control aico-preorder2-field-control-select">
            <svg class="aico-preorder2-field-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <div class="aico-preorder2-custom-select aico-preorder2-custom-select-grow" data-aico-custom-select>
              <select name="delivery_address_id"
                      class="aico-preorder2-select-native"
                      tabindex="-1"
                      aria-labelledby="aico-preorder2-delivery-label"
                      aria-hidden="true"
                      data-aico-preorder2-select="delivery_address_id"
                      data-placeholder="{{ 'aico_preorder.filters.delivery_placeholder' | t }}"
                      {% if aico_preorder.delivery_addresses == empty %}disabled{% endif %}>
                <option value="">{{ 'aico_preorder.filters.delivery_placeholder' | t }}</option>
                {% for address in aico_preorder.delivery_addresses %}
                  <option value="{{ address.id }}" data-country="{{ address.country }}">{{ address.label }}</option>
                {% endfor %}
              </select>
              <button type="button"
                      id="aico-preorder2-delivery-trigger"
                      class="aico-preorder2-custom-select-trigger"
                      data-aico-custom-select-trigger
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-labelledby="aico-preorder2-delivery-label"
                      {% if aico_preorder.delivery_addresses == empty %}disabled{% endif %}>
                <span class="aico-preorder2-custom-select-label" data-aico-custom-select-label></span>
                <svg class="aico-preorder2-custom-select-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="aico-preorder2-custom-select-dropdown" data-aico-custom-select-dropdown hidden>
                <div role="listbox" class="aico-preorder2-custom-select-list" data-aico-custom-select-list></div>
              </div>
            </div>
          </div>
        </div>
        </div>

        <div class="aico-preorder2-catalog-tools" data-aico-preorder2-catalog-tools>
        <label class="aico-preorder2-field aico-preorder2-field-search" data-aico-field="search">
          <span class="aico-preorder2-field-label">{{ 'aico_preorder.filters.search_label' | t }}</span>
          <span class="aico-preorder2-field-control">
            <svg class="aico-preorder2-field-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input type="search" class="aico-preorder2-search-input" name="q"
                   placeholder="{{ 'aico_preorder.filters.search_placeholder' | t }}"
                   data-aico-preorder2-search>
          </span>
        </label>

        <div class="aico-preorder2-field aico-preorder2-field-dates" data-aico-field="dates">
          <span id="aico-preorder2-dates-label" class="aico-preorder2-field-label">{{ 'aico_preorder.catalog.dates_label' | t }}</span>
          <div class="aico-preorder2-field-control aico-preorder2-field-control-select">
            <svg class="aico-preorder2-field-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path>
            </svg>
            <div class="aico-preorder2-custom-select aico-preorder2-custom-select-grow" data-aico-custom-select data-aico-custom-select-managed>
              <select name="date_filter" class="aico-preorder2-select-native" tabindex="-1" aria-hidden="true"
                      aria-labelledby="aico-preorder2-dates-label" data-aico-preorder2-date-select>
                <option value="__all__">{{ 'aico_preorder.catalog.dates_all' | t }}</option>
              </select>
              <button type="button" id="aico-preorder2-dates-trigger" class="aico-preorder2-custom-select-trigger"
                      data-aico-custom-select-trigger aria-haspopup="listbox" aria-expanded="false"
                      aria-labelledby="aico-preorder2-dates-label">
                <span class="aico-preorder2-custom-select-label" data-aico-custom-select-label></span>
                <svg class="aico-preorder2-custom-select-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="aico-preorder2-custom-select-dropdown" data-aico-custom-select-dropdown hidden>
                <div role="listbox" class="aico-preorder2-custom-select-list" data-aico-custom-select-list></div>
              </div>
            </div>
          </div>
        </div>

        {%- assign size_selected = aico_preorder.size_region | default: 'EU' | upcase -%}
        <div class="aico-preorder2-field aico-preorder2-field-size" data-aico-field="size_region">
          <span id="aico-preorder2-size-label" class="aico-preorder2-field-label">{{ 'aico_preorder.filters.size_region_label' | t }}</span>
          <div class="aico-preorder2-field-control aico-preorder2-field-control-select">
            <div class="aico-preorder2-custom-select aico-preorder2-custom-select-grow" data-aico-custom-select>
              <select name="size_region" class="aico-preorder2-select-native" tabindex="-1" aria-hidden="true"
                      data-aico-preorder2-select="size_region">
                <option value="EU" {% if size_selected == 'EU' %}selected{% endif %}>{{ 'aico_preorder.filters.size_region_option_eu' | t }}</option>
                <option value="UK" {% if size_selected == 'UK' %}selected{% endif %}>{{ 'aico_preorder.filters.size_region_option_uk' | t }}</option>
                <option value="US" {% if size_selected == 'US' %}selected{% endif %}>{{ 'aico_preorder.filters.size_region_option_us' | t }}</option>
                <option value="KR" {% if size_selected == 'KR' %}selected{% endif %}>{{ 'aico_preorder.filters.size_region_option_mm' | t }}</option>
              </select>
              <button type="button" id="aico-preorder2-size-trigger" class="aico-preorder2-custom-select-trigger"
                      data-aico-custom-select-trigger aria-haspopup="listbox" aria-expanded="false"
                      aria-labelledby="aico-preorder2-size-label">
                <span class="aico-preorder2-custom-select-label" data-aico-custom-select-label></span>
                <svg class="aico-preorder2-custom-select-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="aico-preorder2-custom-select-dropdown" data-aico-custom-select-dropdown hidden>
                <div role="listbox" class="aico-preorder2-custom-select-list" data-aico-custom-select-list></div>
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} Display options: a gear that opens a small popover controlling
           how compact the catalog renders. Pure client-side view state (persisted in
           localStorage), applied as a class/attribute on the .aico-preorder2 root so it
           survives catalog re-renders. {%- endcomment -%}
        <div class="aico-preorder2-field aico-preorder2-field-display" data-aico-field="display" data-aico-preorder2-display>
          <button type="button" class="aico-preorder2-display-trigger" data-aico-preorder2-display-trigger
                  aria-haspopup="true" aria-expanded="false" title="{{ 'aico_preorder.display.button_label' | t }}"
                  aria-label="{{ 'aico_preorder.display.button_label' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </button>
          <div class="aico-preorder2-display-panel" data-aico-preorder2-display-panel hidden role="dialog" aria-label="{{ 'aico_preorder.display.button_label' | t }}">
            <p class="aico-preorder2-display-heading">{{ 'aico_preorder.display.heading' | t }}</p>

            <label class="aico-preorder2-display-toggle">
              <input type="checkbox" data-aico-preorder2-display-strip checked>
              <span class="aico-preorder2-display-toggle-text">{{ 'aico_preorder.display.show_strip' | t }}</span>
            </label>

            <div class="aico-preorder2-display-group" role="radiogroup" aria-label="{{ 'aico_preorder.display.size_labels_label' | t }}">
              <p class="aico-preorder2-display-group-label">{{ 'aico_preorder.display.size_labels_label' | t }}</p>
              <label class="aico-preorder2-display-radio">
                <input type="radio" name="aico-preorder2-size-labels" value="all" data-aico-preorder2-display-sizes checked>
                <span>{{ 'aico_preorder.display.size_labels_all' | t }}</span>
              </label>
              <label class="aico-preorder2-display-radio">
                <input type="radio" name="aico-preorder2-size-labels" value="first" data-aico-preorder2-display-sizes>
                <span>{{ 'aico_preorder.display.size_labels_first' | t }}</span>
              </label>
              <label class="aico-preorder2-display-radio">
                <input type="radio" name="aico-preorder2-size-labels" value="none" data-aico-preorder2-display-sizes>
                <span>{{ 'aico_preorder.display.size_labels_none' | t }}</span>
              </label>
            </div>
          </div>
        </div>
        </div>
      </form>
    </div>
  </section>

  <section class="aico-preorder2-prompt aico-page-container" data-aico-preorder2-prompt aria-live="polite">
    <h2 class="aico-preorder2-prompt-title">{{ 'aico_preorder.catalog.select_addresses' | t }}</h2>
  </section>

  <section class="aico-preorder2-reopen-notice aico-page-container" data-aico-preorder2-reopen-notice hidden aria-live="polite" role="status">
    <div class="aico-preorder2-reopen-notice-inner">
      <div class="aico-preorder2-reopen-skeleton" aria-hidden="true">
        <span class="aico-preorder2-reopen-skeleton-bar aico-preorder2-reopen-skeleton-title"></span>
        <span class="aico-preorder2-reopen-skeleton-bar aico-preorder2-reopen-skeleton-line"></span>
        <span class="aico-preorder2-reopen-skeleton-bar aico-preorder2-reopen-skeleton-btn"></span>
      </div>
      <h2 class="aico-preorder2-reopen-notice-title">{{ 'aico_preorder.reopen_notice.title' | t }}</h2>
      <p class="aico-preorder2-reopen-notice-body">{{ 'aico_preorder.reopen_notice.body' | t }}</p>
      <button type="button" class="aico-preorder2-reopen-notice-btn" data-aico-preorder2-reopen-ack>{{ 'aico_preorder.reopen_notice.acknowledge' | t }}</button>
    </div>
  </section>

  {%- comment -%}
    Eligibility hard-block: shown (red) when the selected (customer, delivery,
    billing) context is not configured to place a preorder — e.g. a debtor with
    no seller/currency, a missing price list, or an incomplete address. The
    catalog + checkout stay hidden until the configuration is fixed; there is no
    acknowledge button (unlike the reopen notice) — only support can clear it.
    The per-problem sentence is selected client-side by the problem `code` from
    the data-aico-elig-msg-* templates below ({label} = the affected
    address/customer), so copy lives in locales and stays Shopify-compatible.
  {%- endcomment -%}
  <section
    class="aico-preorder2-eligibility-notice aico-page-container"
    data-aico-preorder2-eligibility-notice
    hidden
    aria-live="assertive"
    role="alert"
    data-aico-elig-msg-debtor-missing="{{ 'aico_preorder.eligibility.debtor_missing' | t }}"
    data-aico-elig-msg-debtor-missing-seller="{{ 'aico_preorder.eligibility.debtor_missing_seller' | t }}"
    data-aico-elig-msg-debtor-missing-currency="{{ 'aico_preorder.eligibility.debtor_missing_currency' | t }}"
    data-aico-elig-msg-missing-price-list="{{ 'aico_preorder.eligibility.missing_price_list' | t }}"
    data-aico-elig-msg-delivery-address-invalid="{{ 'aico_preorder.eligibility.delivery_address_invalid' | t }}"
    data-aico-elig-msg-billing-address-invalid="{{ 'aico_preorder.eligibility.billing_address_invalid' | t }}"
    data-aico-elig-msg-tax-not-configured="{{ 'aico_preorder.eligibility.tax_not_configured' | t }}"
    data-aico-elig-msg-fallback="{{ 'aico_preorder.eligibility.fallback' | t }}"
  >
    <div class="aico-preorder2-eligibility-notice-inner">
      <h2 class="aico-preorder2-eligibility-notice-title">{{ 'aico_preorder.eligibility.title' | t }}</h2>
      <p class="aico-preorder2-eligibility-notice-intro">{{ 'aico_preorder.eligibility.intro' | t }}</p>
      <ul class="aico-preorder2-eligibility-notice-list" data-aico-preorder2-eligibility-list></ul>
      <p class="aico-preorder2-eligibility-notice-support">{{ 'aico_preorder.eligibility.contact_support' | t }}</p>
    </div>
  </section>

  <section class="aico-preorder2-main-wrap aico-page-container" aria-labelledby="aico-preorder2-main-title" hidden data-aico-preorder2-main>
    <h2 id="aico-preorder2-main-title" class="aico-sr-only">{{ 'aico_preorder.catalog.section_aria' | t }}</h2>
    <p class="aico-preorder2-catalog-error" data-aico-preorder2-error hidden role="alert">{{ 'aico_preorder.catalog.error' | t }}</p>

    <div class="aico-preorder2-catalog" data-aico-preorder2-catalog></div>

    <section class="aico-preorder2-flyers" data-aico-preorder2-flyers hidden aria-label="{{ 'aico_preorder.flyers.section_aria' | t }}">
      <h3 class="aico-preorder2-flyers-title">{{ 'aico_preorder.flyers.title' | t }}</h3>
      <div class="aico-preorder2-flyers-grid" data-aico-preorder2-flyers-grid></div>
    </section>
  </section>

  <section class="aico-preorder2-checkout-wrap aico-page-container" hidden data-aico-preorder2-checkout>
    <div class="aico-preorder2-checkout-panel" data-aico-preorder2-summary aria-label="{{ 'aico_preorder.summary.section_aria' | t }}">
      <div class="aico-preorder2-checkout-addresses">
        <div class="aico-preorder2-checkout-address">
          <p class="aico-preorder2-checkout-address-label">{{ 'aico_preorder.summary.billing_address' | t }}</p>
          <p class="aico-preorder2-checkout-address-value" data-aico-preorder2-summary-billing>—</p>
        </div>
        <div class="aico-preorder2-checkout-address">
          <p class="aico-preorder2-checkout-address-label">{{ 'aico_preorder.summary.delivery_address' | t }}</p>
          <p class="aico-preorder2-checkout-address-value" data-aico-preorder2-summary-delivery>—</p>
        </div>
      </div>
      <hr class="aico-preorder2-checkout-divider">
      <div class="aico-preorder2-checkout-grid">
        <div class="aico-preorder2-checkout-dates" data-aico-preorder2-summary-lines></div>
        <div class="aico-preorder2-checkout-totals-box">
          <div class="aico-preorder2-checkout-total-row" data-aico-preorder2-summary-subtotal-row></div>
          <div class="aico-preorder2-checkout-total-row" data-aico-preorder2-summary-discount-row hidden></div>
          <hr class="aico-preorder2-checkout-divider">
          <div class="aico-preorder2-checkout-grand-total" data-aico-preorder2-summary-total></div>
        </div>
      </div>
      <p class="aico-preorder2-checkout-alert" data-aico-preorder2-stock-warning>
        <svg class="aico-preorder2-checkout-alert__icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13Zm0 1.3a5.2 5.2 0 1 1 0 10.4 5.2 5.2 0 0 1 0-10.4ZM8 4.1a.95.95 0 1 0 0 1.9.95.95 0 0 0 0-1.9Zm-.8 3.05V11.9h1.6V7.15H7.2Z"/></svg>
        <span class="aico-preorder2-checkout-alert__text">{{ 'aico_preorder.summary.stock_warning' | t }}</span>
      </p>
      {%- comment -%}
      <label class="aico-preorder2-notes">
        <span class="aico-preorder2-field-label">{{ 'aico_preorder.summary.notes_label' | t }}</span>
        <textarea name="notes" rows="3" data-aico-preorder2-notes></textarea>
      </label>
      {%- endcomment -%}
      {%- comment -%}
        The AGB link must point at the same document as the footer's Terms &
        Conditions entry, including its locale override (layout/theme.liquid).
      {%- endcomment -%}
      {%- assign terms_locale = request.locale.iso_code | default: shop.default_locale -%}
      {%- assign terms_url = preorder_session.terms_pdf_url -%}
      {%- for footer_link in linklists.footer.links -%}
        {%- if footer_link.aico_title_key == 'home_page.footer.terms' -%}
          {%- assign terms_url = footer_link.url -%}
          {%- if footer_link.aico_url_de_ch and terms_locale == 'de_CH' -%}
            {%- assign terms_url = footer_link.aico_url_de_ch -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {% if terms_url != blank %}
        <label class="aico-preorder2-terms">
          <input type="checkbox" data-aico-preorder2-terms>
          <span>{{ 'aico_preorder.summary.terms_prefix' | t }}
            <a href="{{ terms_url }}" target="_blank" rel="noopener">{{ 'aico_preorder.summary.terms_link' | t }}</a>
          </span>
        </label>
      {% else %}
        <label class="aico-preorder2-terms">
          <input type="checkbox" data-aico-preorder2-terms>
          <span>{{ 'aico_preorder.summary.terms_checkbox' | t }}</span>
        </label>
      {% endif %}
      <p class="aico-preorder2-summary-status" data-aico-preorder2-summary-status hidden></p>
      <div class="aico-preorder2-checkout-actions">
        <button type="button" class="aico-preorder2-btn aico-preorder2-btn-place" data-aico-preorder2-submit disabled>{{ 'aico_preorder.summary.place_order' | t }}</button>
      </div>
    </div>
  </section>

  {%- comment -%} Sticky cart-summary panel — read-only live totals + a colour
       legend for the qty cells. Docks in the page gutter on wide (1080p+)
       screens (default right; the user can flip the side, persisted), and
       collapses to an edge tab on narrower screens. Ordering stays in the
       checkout section above; this panel has no action button. Visibility
       tracks the checkout section (shown once a session + addresses are set). {%- endcomment -%}
  <aside class="aico-preorder2-cart-panel" data-aico-preorder2-cart-panel data-side="right" hidden
         aria-label="{{ 'aico_preorder.cart_panel.title' | t }}">
    <button type="button" class="aico-preorder2-cart-panel-tab" data-aico-preorder2-cart-panel-tab
            aria-expanded="false" aria-label="{{ 'aico_preorder.cart_panel.show' | t }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <span class="aico-preorder2-cart-panel-tab-qty" data-aico-preorder2-cart-panel-tab-qty>0</span>
    </button>

    <div class="aico-preorder2-cart-panel-body">
      <div class="aico-preorder2-cart-panel-head">
        <h3 class="aico-preorder2-cart-panel-title">{{ 'aico_preorder.cart_panel.title' | t }}</h3>
        <div class="aico-preorder2-cart-panel-head-actions">
          <button type="button" class="aico-preorder2-cart-panel-side" data-aico-preorder2-cart-panel-side
                  title="{{ 'aico_preorder.cart_panel.toggle_side' | t }}" aria-label="{{ 'aico_preorder.cart_panel.toggle_side' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
              <polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
            </svg>
          </button>
          <button type="button" class="aico-preorder2-cart-panel-close" data-aico-preorder2-cart-panel-close
                  aria-label="{{ 'aico_preorder.cart_panel.hide' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <dl class="aico-preorder2-cart-panel-rows">
        <div class="aico-preorder2-cart-panel-row">
          <dt class="aico-preorder2-cart-panel-info" data-aico-cart-panel-info>
            <span>{{ 'aico_preorder.cart_panel.placed_orders' | t }}</span>
            <button type="button" class="aico-preorder2-cart-panel-info-trigger" data-aico-cart-panel-info-trigger
                    aria-haspopup="dialog" aria-expanded="false" aria-controls="aico-preorder2-cart-panel-placed-info"
                    aria-label="{{ 'aico_preorder.cart_panel.placed_orders' | t | escape }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            </button>
            <span class="aico-preorder2-cart-panel-info-pop" id="aico-preorder2-cart-panel-placed-info" role="dialog" aria-label="{{ 'aico_preorder.cart_panel.placed_orders' | t | escape }}">{{ 'aico_preorder.cart_panel.placed_orders_info' | t }}</span>
          </dt>
          <dd data-aico-preorder2-cart-panel-placed>—</dd>
        </div>
        <div class="aico-preorder2-cart-panel-row">
          <dt>{{ 'aico_preorder.cart_panel.total_qty' | t }}</dt>
          <dd data-aico-preorder2-cart-panel-total-qty>—</dd>
        </div>
        <div class="aico-preorder2-cart-panel-row">
          <dt>{{ 'aico_preorder.cart_panel.discount' | t }}</dt>
          <dd data-aico-preorder2-cart-panel-discount>—</dd>
        </div>
        <div class="aico-preorder2-cart-panel-row">
          <dt>{{ 'aico_preorder.cart_panel.next_tier' | t }}</dt>
          <dd data-aico-preorder2-cart-panel-next-tier>—</dd>
        </div>
        <div class="aico-preorder2-cart-panel-row aico-preorder2-cart-panel-row--subtotal">
          <dt>{{ 'aico_preorder.cart_panel.total' | t }}</dt>
          <dd data-aico-preorder2-cart-panel-subtotal>—</dd>
        </div>
      </dl>

      <div class="aico-preorder2-cart-panel-legend" data-aico-preorder2-cart-panel-legend>
        <button type="button" class="aico-preorder2-cart-panel-legend-trigger" data-aico-preorder2-cart-panel-legend-trigger
                aria-haspopup="dialog" aria-expanded="false" aria-controls="aico-preorder2-cart-panel-legend-pop">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <span>{{ 'aico_preorder.cart_panel.legend_title' | t }}</span>
        </button>
        <div class="aico-preorder2-cart-panel-legend-pop" id="aico-preorder2-cart-panel-legend-pop" role="dialog" aria-label="{{ 'aico_preorder.cart_panel.legend_title' | t }}">
          <p class="aico-preorder2-cart-panel-legend-pop-title">{{ 'aico_preorder.cart_panel.legend_title' | t }}</p>
          <div class="aico-preorder2-cart-panel-legend-row"><span class="aico-preorder2-cart-panel-swatch aico-preorder2-cart-panel-swatch--available"></span>{{ 'aico_preorder.cart_panel.legend_available' | t }}</div>
          <div class="aico-preorder2-cart-panel-legend-row"><span class="aico-preorder2-cart-panel-swatch aico-preorder2-cart-panel-swatch--editing"></span>{{ 'aico_preorder.cart_panel.legend_editing' | t }}</div>
          <div class="aico-preorder2-cart-panel-legend-row"><span class="aico-preorder2-cart-panel-swatch aico-preorder2-cart-panel-swatch--selected"></span>{{ 'aico_preorder.cart_panel.legend_selected' | t }}</div>
          <div class="aico-preorder2-cart-panel-legend-row"><span class="aico-preorder2-cart-panel-swatch aico-preorder2-cart-panel-swatch--committed"></span>{{ 'aico_preorder.cart_panel.legend_committed' | t }}</div>
          <div class="aico-preorder2-cart-panel-legend-row"><span class="aico-preorder2-cart-panel-swatch aico-preorder2-cart-panel-swatch--unavailable"></span>{{ 'aico_preorder.cart_panel.legend_unavailable' | t }}</div>
        </div>
      </div>
    </div>
  </aside>

  {%- comment -%} Inline preorder confirmation (no thank-you-url path): hidden until
       preorder2-page.js reveals it on a successful submit and calls
       AicoPreorderConfirmation.start(). When a thank-you-url IS set, the submit
       flow redirects to templates/aico-preorder2-thank-you.liquid instead and this
       panel stays hidden. Markup mirrors that template (no shared snippet because
       {% render %} does not resolve to files here). {%- endcomment -%}
  <section
    class="aico-preorder2-confirmation aico-page-container"
    data-aico-preorder2-confirmation
    hidden
    data-aico-confirmation-url="{{ routes.aico_preorder_cart_confirmation_url }}"
    data-aico-confirmation-title="{{ 'aico_preorder.confirmation.title' | t | escape }}"
    data-aico-confirmation-message="{{ 'aico_preorder.confirmation.message' | t | escape }}"
    data-aico-confirmation-processing-title="{{ 'aico_preorder.confirmation.processing_title' | t | escape }}"
    data-aico-confirmation-processing-message="{{ 'aico_preorder.confirmation.processing_message' | t | escape }}"
    data-aico-confirmation-almost-there="{{ 'aico_preorder.confirmation.almost_there' | t | escape }}"
    data-aico-confirmation-stage-checking="{{ 'aico_preorder.confirmation.stage_checking' | t | escape }}"
    data-aico-confirmation-stage-saving="{{ 'aico_preorder.confirmation.stage_saving' | t | escape }}"
    data-aico-confirmation-stage-updating="{{ 'aico_preorder.confirmation.stage_updating' | t | escape }}"
    data-aico-confirmation-stage-finalizing="{{ 'aico_preorder.confirmation.stage_finalizing' | t | escape }}"
    data-aico-confirmation-delayed="{{ 'aico_preorder.confirmation.delayed' | t | escape }}"
    data-aico-confirmation-stage-checking="{{ 'aico_preorder.confirmation.stage_checking' | t | escape }}"
    data-aico-confirmation-stage-saving="{{ 'aico_preorder.confirmation.stage_saving' | t | escape }}"
    data-aico-confirmation-stage-updating="{{ 'aico_preorder.confirmation.stage_updating' | t | escape }}"
    data-aico-confirmation-stage-finalizing="{{ 'aico_preorder.confirmation.stage_finalizing' | t | escape }}"
    data-aico-confirmation-delayed="{{ 'aico_preorder.confirmation.delayed' | t | escape }}"
    data-aico-confirmation-error-title="{{ 'aico_preorder.confirmation.error_title' | t | escape }}"
    data-aico-confirmation-error-message="{{ 'aico_preorder.confirmation.error_message' | t | escape }}"
    data-aico-confirmation-update-error-title="{{ 'aico_preorder.confirmation.update_error_title' | t | escape }}"
    data-aico-confirmation-update-error-message="{{ 'aico_preorder.confirmation.update_error_message' | t | escape }}"
    data-aico-confirmation-update-error-title="{{ 'aico_preorder.confirmation.update_error_title' | t | escape }}"
    data-aico-confirmation-update-error-message="{{ 'aico_preorder.confirmation.update_error_message' | t | escape }}"
    data-aico-confirmation-missing-title="{{ 'aico_preorder.confirmation.missing_title' | t | escape }}"
    data-aico-confirmation-missing-message="{{ 'aico_preorder.confirmation.missing_message' | t | escape }}"
    data-aico-confirmation-update-title="{{ 'aico_preorder.confirmation.update_title' | t | escape }}"
    data-aico-confirmation-update-message="{{ 'aico_preorder.confirmation.update_message' | t | escape }}"
    data-aico-confirmation-number-pending="{{ 'aico_preorder.confirmation.number_pending' | t | escape }}"
    data-aico-confirmation-pcs="{{ 'aico_preorder.catalog.pcs' | t | escape }}"
    data-aico-confirmation-pdf-generating="{{ 'aico_preorder.confirmation.pdf_generating' | t | escape }}"
    data-aico-confirmation-pdf-download="{{ 'aico_preorder.confirmation.pdf_download' | t | escape }}"
    data-aico-confirmation-pdf-unavailable="{{ 'aico_preorder.confirmation.pdf_unavailable' | t | escape }}">

    {%- comment -%} Status medallion — see the note on the same block in
      templates/aico-preorder2-thank-you.liquid: shared with the checkout
      thank-you, doubles as the submit progress ring, and lives outside the
      header so the processing → confirmed panel swap cannot fade its
      spinner → checkmark hand-off away. {%- endcomment -%}
    <div class="aico-ty-status" aria-hidden="true" data-aico-confirmation-status>
      <svg class="aico-ty-status-svg" viewBox="0 0 52 52" focusable="false" role="presentation">
        <circle class="aico-ty-status-track" cx="26" cy="26" r="24"/>
        <circle class="aico-ty-status-spin" cx="26" cy="26" r="24"/>
        <circle class="aico-ty-status-ring" cx="26" cy="26" r="24"/>
        <circle class="aico-ty-status-disc" cx="26" cy="26" r="24"/>
        <path class="aico-ty-status-check" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
        {%- comment -%} Warning state — the panel was revealed with no cart id to
          confirm against, so no details will ever arrive. Same markup as the
          standalone thank-you template's medallion. {%- endcomment -%}
        <circle class="aico-ty-status-warn-disc" cx="26" cy="26" r="24"/>
        <path class="aico-ty-status-warn-triangle" d="M26 15.4 38.4 36.6 13.6 36.6 Z"/>
        <path class="aico-ty-status-warn-bang" d="M26 22.6V29.4"/>
        <circle class="aico-ty-status-warn-dot" cx="26" cy="33.1" r="1.45"/>
      </svg>
    </div>

    {%- comment -%} Submit progress count — same block as the thank-you
      template: directly under the medallion so it reads as the spinner's
      caption, hidden until a counter exists. {%- endcomment -%}
    <div class="aico-preorder2-confirmation-progress" data-aico-confirmation-progress hidden
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      aria-label="{{ 'aico_preorder.confirmation.processing_title' | t | escape }}"
      data-aico-confirmation-progress-template="{{ 'aico_preorder.confirmation.progress_count' | t | escape }}">
      <span class="aico-preorder2-confirmation-progress-count" data-aico-confirmation-progress-count></span>
    </div>

    <header class="aico-preorder2-confirmation-head">
      <h2 class="aico-preorder2-confirmation-title" data-aico-confirmation-header>{{ 'aico_preorder.confirmation.title' | t }}</h2>
      <p class="aico-preorder2-confirmation-message" data-aico-confirmation-message>{{ 'aico_preorder.confirmation.message' | t }}</p>
    </header>

    <div class="aico-preorder2-confirmation-number-box">
      <span class="aico-preorder2-confirmation-number-label">{{ 'aico_preorder.confirmation.number_label' | t }}</span>
      <span class="aico-preorder2-confirmation-number" data-aico-confirmation-number>…</span>
      <span class="aico-preorder2-confirmation-reference">
        {{ 'aico_preorder.confirmation.reference_label' | t }}
        <span data-aico-confirmation-reference></span>
      </span>
    </div>

    <div class="aico-preorder2-confirmation-summary">
      <div class="aico-preorder2-confirmation-address">
        <span class="aico-preorder2-confirmation-summary-label">{{ 'aico_preorder.confirmation.delivery_address' | t }}</span>
        <div class="aico-preorder2-confirmation-address-value" data-aico-confirmation-address>—</div>
      </div>
      <dl class="aico-preorder2-confirmation-totals">
        <div class="aico-preorder2-confirmation-total-row">
          <dt>{{ 'aico_preorder.confirmation.item_count' | t }}</dt>
          <dd data-aico-confirmation-item-count>0</dd>
        </div>
        <div class="aico-preorder2-confirmation-total-row" data-aico-confirmation-discount-row>
          <dt>{{ 'aico_preorder.confirmation.discount' | t }}</dt>
          <dd data-aico-confirmation-discount>&ndash;</dd>
        </div>
        <div class="aico-preorder2-confirmation-total-row aico-preorder2-confirmation-total-row--grand">
          <dt>{{ 'aico_preorder.confirmation.total' | t }}</dt>
          <dd data-aico-confirmation-total>&mdash;</dd>
        </div>
        {%- comment -%} The same total with VAT added — the net figure above is what
          the tier discount and the price list produce; this is what the invoice will
          say. Both come from the confirmation endpoint; the theme never does money
          arithmetic of its own. {%- endcomment -%}
        <div class="aico-preorder2-confirmation-total-row aico-preorder2-confirmation-total-row--vat">
          <dt>{{ 'aico_preorder.confirmation.total_with_vat' | t }}</dt>
          <dd data-aico-confirmation-total-with-vat>&mdash;</dd>
        </div>
      </dl>
    </div>

    <div class="aico-preorder2-confirmation-dates-wrap">
      <h3 class="aico-preorder2-confirmation-dates-title">{{ 'aico_preorder.confirmation.delivery_dates' | t }}</h3>
      <div class="aico-preorder2-confirmation-dates" data-aico-confirmation-dates></div>
    </div>

    <div class="aico-preorder2-confirmation-pdf-area" data-aico-confirmation-pdf aria-live="polite" aria-busy="true">
      <span class="aico-preorder2-confirmation-pdf-spinner" aria-hidden="true"></span>
      <span>{{ 'aico_preorder.confirmation.pdf_generating' | t }}</span>
    </div>

    <p class="aico-preorder2-confirmation-links">
      <a class="aico-btn aico-btn-secondary" href="{{ routes.root_url }}">{{ 'aico_preorder.thank_you.continue_shopping' | t }}</a>
    </p>
  </section>

  <div class="aico-preorder2-gallery" data-aico-preorder2-gallery hidden role="dialog" aria-modal="true" aria-labelledby="aico-preorder2-gallery-title">
    <div class="aico-preorder2-gallery-backdrop" data-aico-preorder2-gallery-close></div>
    <div class="aico-preorder2-gallery-dialog" role="document">
      <button type="button" class="aico-preorder2-gallery-close" data-aico-preorder2-gallery-close aria-label="{{ 'general.close' | t | default: 'Schliessen' }}">&times;</button>
      <h3 class="aico-preorder2-gallery-title" id="aico-preorder2-gallery-title" data-aico-preorder2-gallery-title></h3>
      <div class="aico-preorder2-gallery-stage">
        <button type="button" class="aico-preorder2-gallery-nav aico-preorder2-gallery-prev" data-aico-preorder2-gallery-prev aria-label="Zurück" hidden>&lsaquo;</button>
        <div class="aico-preorder2-gallery-main">
          <img class="aico-preorder2-gallery-main-img" data-aico-preorder2-gallery-main alt="" decoding="async">
          <p class="aico-preorder2-gallery-empty" data-aico-preorder2-gallery-empty hidden>{{ 'aico_preorder.catalog.error' | t }}</p>
        </div>
        <button type="button" class="aico-preorder2-gallery-nav aico-preorder2-gallery-next" data-aico-preorder2-gallery-next aria-label="Weiter" hidden>&rsaquo;</button>
      </div>
      <div class="aico-preorder2-gallery-thumbs" data-aico-preorder2-gallery-thumbs></div>
    </div>
  </div>

  <script src="{{ 'preorder2-catalog.js' | asset_url }}" defer></script>
  <script src="{{ 'preorder2-stock.js' | asset_url }}" defer></script>
  <script src="{{ 'preorder2-cart.js' | asset_url }}" defer></script>
  <script src="{{ 'preorder2-header.js' | asset_url }}" defer></script>
  <script src="{{ 'preorder2-confirmation.js' | asset_url }}" defer></script>
  <script src="{{ 'preorder2-page.js' | asset_url }}" defer></script>
</main>