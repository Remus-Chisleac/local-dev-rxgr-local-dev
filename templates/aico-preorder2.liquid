            <svg class="aico-preorder2-field-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 14V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v8"></path>
              <path d="M3 14h18"></path>
              <path d="M5 14v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"></path>
            </svg>
            <div class="aico-preorder2-custom-select aico-preorder2-custom-select-grow" data-aico-custom-select>
              <select name="billing_address_id"
                      class="aico-preorder2-select-native"
                      tabindex="-1"
                      aria-labelledby="aico-preorder2-billing-label"
                      aria-hidden="true"
                      data-aico-preorder2-select="billing_address_id"
