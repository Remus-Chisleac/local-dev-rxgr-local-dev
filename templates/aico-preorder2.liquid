{% comment %}
  AICO preorder page — /preorder2 VARIANT (fully forked).

  A fork of `aico-preorder.liquid` that exists so preorder-tool changes can be
  trialled without touching the live /preorder page. EVERYTHING here is a
  separate copy: this template, the `preorder2-{page,catalog,cart,stock,
  confirmation}.js` bundles, and `preorder2-page.css` — all generated from the
  /preorder originals with every `aico-preorder` class/data-attribute renamed to
  `aico-preorder2`, so no theme.css preorder rule and no shared bundle touches
  this page. Edit the preorder2-* files freely; keep /preorder's files alone.

  On top of the plain copy this variant adds the header dock below (title +
  mirrored search/dates/size controls docking over the sticky header, driven by
  `preorder2-header.js`) and hides the global search/cart/customer-view chrome
  (gated on `template.name` in layout/theme.liquid).

  The drop (`aico_preorder`) reaches this template through the build-time drops
  manifest — the renderer schedules whatever keys a template's Liquid names, so
  no descriptor or route code knows this filename.
{% endcomment %}

{%- assign preorder_session = aico_preorder.session -%}
{%- comment -%} The active session (title, banner image, gradient colors, deadline)
   is resolved per buyer/debtor and hydrated CLIENT-SIDE from
   `preorder/session.js` — it is not bound to the Liquid drop at first render
   (same as the countdown). The hero is therefore a shell that `preorder2-page.js`
   fills in: title from `welcomeMessage`, image from `collectionImage`, and the
   full-bleed vertical gradient from `gradientColorStart/End`. No hardcoded asset. {%- endcomment -%}

<link rel="stylesheet" href="{{ 'preorder2-page.css' | asset_url }}">

<main class="aico-preorder2" role="main"
      data-aico-preorder2
      data-aico-preorder2-user-id="{{ customer.id }}"
      data-aico-preorder2-context-url="{{ routes.aico_account_preorder_context_url }}"
      data-aico-preorder2-session-url="{{ routes.aico_preorder_session_url }}"
      data-aico-preorder2-products-url="{{ routes.aico_preorder_products_url }}"
      data-aico-preorder2-product-images-url="{{ routes.aico_preorder_product_images_url }}"
      data-aico-preorder2-cart-url="{{ routes.aico_preorder_cart_url }}"
      data-aico-preorder2-cart-add-url="{{ routes.aico_preorder_cart_add_url }}"
      data-aico-preorder2-cart-change-url="{{ routes.aico_preorder_cart_change_url }}"
      data-aico-preorder2-cart-clear-url="{{ routes.aico_preorder_cart_clear_url }}"
      data-aico-preorder2-cart-submit-url="{{ routes.aico_preorder_cart_submit_url }}"
      data-aico-preorder2-thank-you-url="{{ routes.aico_preorder_thank_you_url }}"
      data-aico-preorder2-addresses-url="{{ routes.aico_preorder_addresses_url }}"
      data-aico-preorder2-eligibility-url="{{ routes.aico_preorder_eligibility_url }}"
      data-aico-preorder2-b2bs-url="{{ routes.aico_preorder_b2bs_url }}"
      data-aico-preorder2-is-manager="{% if aico_preorder.is_manager %}1{% else %}0{% endif %}"
      data-aico-preorder2-selected-debtor-id="{{ aico_preorder.selected_debtor_id }}"
      data-aico-preorder2-enable-cart="1"
      data-aico-preorder2-copy-select-debtor="{{ 'aico_preorder.catalog.select_debtor' | t | escape }}"
      data-aico-preorder2-is-stock-relevant="{% if preorder_session.is_stock_relevant %}1{% else %}0{% endif %}"
      data-aico-preorder2-copy-empty="{{ 'aico_preorder.catalog.empty' | t | escape }}"
      data-aico-preorder2-copy-loading="{{ 'aico_preorder.catalog.loading' | t | escape }}"
      data-aico-preorder2-copy-error="{{ 'aico_preorder.catalog.error' | t | escape }}"
      data-aico-preorder2-copy-select-addresses="{{ 'aico_preorder.catalog.select_addresses' | t | escape }}"
      data-aico-preorder2-copy-total="{{ 'aico_preorder.summary.total' | t | escape }}"
      data-aico-preorder2-copy-discount="{{ 'aico_preorder.summary.discount' | t | escape }}"
      data-aico-preorder2-copy-saving="{{ 'aico_preorder.summary.saving' | t | escape }}"
      data-aico-preorder2-copy-saved="{{ 'aico_preorder.summary.saved' | t | escape }}"
      data-aico-preorder2-copy-submitting="{{ 'aico_preorder.summary.submitting' | t | escape }}"
      data-aico-preorder2-copy-submitted="{{ 'aico_preorder.summary.submitted' | t | escape }}"
      data-aico-preorder2-copy-committed="{{ 'aico_preorder.summary.committed_warning' | t | escape }}"
      data-aico-preorder2-copy-products-heading="{{ 'aico_preorder.catalog.products_heading' | t | escape }}"
      data-aico-preorder2-copy-row-total="{{ 'aico_preorder.catalog.row_total' | t | escape }}"
      data-aico-preorder2-copy-product-total="{{ 'aico_preorder.catalog.product_total' | t | escape }}"
      data-aico-preorder2-copy-pcs="{{ 'aico_preorder.catalog.pcs' | t | escape }}"
      data-aico-preorder2-copy-flyer-total="{{ 'aico_preorder.flyers.total' | t | escape }}"
      data-aico-preorder2-copy-billing="{{ 'aico_preorder.summary.billing_address' | t | escape }}"
      data-aico-preorder2-copy-delivery="{{ 'aico_preorder.summary.delivery_address' | t | escape }}"
      data-aico-preorder2-copy-excl-vat="{{ 'aico_preorder.summary.excl_vat' | t | escape }}"
      data-aico-preorder2-copy-subtotal="{{ 'aico_preorder.summary.subtotal' | t | escape }}"
      data-aico-preorder2-copy-stock-warning="{{ 'aico_preorder.summary.stock_warning' | t | escape }}"
      {% if preorder_session.deadline_at %}data-aico-preorder2-deadline="{{ preorder_session.deadline_at }}"{% endif %}>

  {%- comment -%} SSR-embedded session payload — the exact shape preorder/session.js
       returns in `data`. preorder2-page.js hydrates from this at first paint and only
       falls back to fetching session.js when it is null/absent. {%- endcomment -%}
  <script type="application/json" data-aico-preorder2-session-json>{{ aico_preorder.session_payload | json }}</script>

  {%- comment -%} ── Header dock (preorder2 only) ──
       Once the hero (title) and the catalog tools (search / delivery dates /
       size type) scroll up behind the sticky site header, they fade in HERE,
       overlaid on the header row. The real controls never move — this is a
       MIRROR that forwards input to them — so every `root.querySelector(...)`
       binding in preorder2-page.js keeps resolving exactly as it does on
       /preorder. assets/preorder2-header.js fills and drives this shell; it is
       empty until then.

       Fixed rather than sticky (the header row is already sticky, and nesting a
       second sticky inside <main> cannot overlay it), and pointer-events:none at
       the root so the brand logo underneath stays clickable. {%- endcomment -%}
  <div class="aico-preorder2-dock" data-aico-preorder2-dock hidden>
    <div class="aico-page-container aico-preorder2-dock-row">
      {%- comment -%} Reserves the width of the header's brand logo so the title
         lands NEXT TO it rather than on top of it. Width set from JS. {%- endcomment -%}
      <span class="aico-preorder2-dock-spacer" data-aico-preorder2-dock-spacer aria-hidden="true"></span>

      <span class="aico-preorder2-dock-title" data-aico-preorder2-dock-title></span>

      <div class="aico-preorder2-dock-tools" data-aico-preorder2-dock-tools>
        {%- comment -%} Each dock control carries a visible mini-title: in the
           header these mirrors sit where site-wide chrome lives, so the search
           especially must say it is the PREORDER product search. {%- endcomment -%}
        <div class="aico-preorder2-dock-field">
          <span class="aico-preorder2-dock-field-label" aria-hidden="true">{{ 'aico_preorder.filters.dock_search_label' | t }}</span>
          <label class="aico-preorder2-dock-search">
            <span class="aico-sr-only">{{ 'aico_preorder.filters.dock_search_label' | t }}</span>
            <svg class="aico-preorder2-dock-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
            </svg>
            <input type="search" class="aico-preorder2-dock-search-input"
                   data-aico-preorder2-dock-search
                   placeholder="{{ 'aico_preorder.filters.search_placeholder' | t }}"
                   autocomplete="off">
          </label>
        </div>

        {%- comment -%} Delivery dates. The real control is a MULTI-select
           checkbox list (its native <select> is a stub — state lives in JS), so
           this mirror clones the real option rows and forwards clicks to them
           rather than mirroring a value. {%- endcomment -%}
        <div class="aico-preorder2-dock-field">
          <span class="aico-preorder2-dock-field-label" aria-hidden="true">{{ 'aico_preorder.catalog.dates_label' | t }}</span>
          <div class="aico-preorder2-dock-select" data-aico-preorder2-dock-dates>
          <button type="button" class="aico-preorder2-dock-select-trigger"
                  data-aico-preorder2-dock-dates-trigger
                  aria-haspopup="listbox" aria-expanded="false"
                  aria-label="{{ 'aico_preorder.catalog.dates_label' | t | escape }}">
            <svg class="aico-preorder2-dock-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path>
            </svg>
            <span class="aico-preorder2-dock-select-label" data-aico-preorder2-dock-dates-label></span>
            <svg class="aico-preorder2-dock-chevron" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="aico-preorder2-dock-select-dropdown" data-aico-preorder2-dock-dates-list role="listbox" hidden></div>
          </div>
        </div>

        {%- comment -%} Size type — a plain single-select mirror: picking an
           option writes the real native <select> and dispatches `change`, which
           is what preorder2-page.js binds (and what relabels its custom UI). {%- endcomment -%}
        <div class="aico-preorder2-dock-field">
          <span class="aico-preorder2-dock-field-label" aria-hidden="true">{{ 'aico_preorder.filters.size_region_label' | t }}</span>
          <div class="aico-preorder2-dock-select" data-aico-preorder2-dock-size>
          <button type="button" class="aico-preorder2-dock-select-trigger"
                  data-aico-preorder2-dock-size-trigger
                  aria-haspopup="listbox" aria-expanded="false"
                  aria-label="{{ 'aico_preorder.filters.size_region_label' | t | escape }}">
            <span class="aico-preorder2-dock-select-label" data-aico-preorder2-dock-size-label></span>
            <svg class="aico-preorder2-dock-chevron" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="aico-preorder2-dock-select-dropdown" data-aico-preorder2-dock-size-list role="listbox" hidden></div>
          </div>
        </div>

        {%- comment -%} Display options mirror — same gear as the filter bar's.
           Rows are cloned from the real panel on open and clicks are forwarded
           to its inputs, so view state + persistence stay in preorder2-page.js.
           No mini-title: the real bar's gear is untitled too. {%- endcomment -%}
        <div class="aico-preorder2-dock-select aico-preorder2-dock-display" data-aico-preorder2-dock-display>
          <button type="button" class="aico-preorder2-dock-select-trigger aico-preorder2-dock-display-trigger"
                  data-aico-preorder2-dock-display-trigger
                  aria-haspopup="dialog" aria-expanded="false"
                  aria-label="{{ 'aico_preorder.display.button_label' | t | escape }}"
                  title="{{ 'aico_preorder.display.button_label' | t | escape }}">
            <svg class="aico-preorder2-dock-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </button>
          <div class="aico-preorder2-dock-select-dropdown aico-preorder2-dock-display-panel" data-aico-preorder2-dock-display-list role="dialog" aria-label="{{ 'aico_preorder.display.button_label' | t | escape }}" hidden></div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ── Hero band: full-bleed vertical gradient (session colors) behind the
       session banner image + title text, with the countdown on the side. The
       image/title/gradient are filled in by preorder2-page.js once the session
       resolves (data hooks below); empty shell until then. {%- endcomment -%}
  <section class="aico-preorder2-hero" data-aico-preorder2-hero aria-labelledby="aico-preorder2-hero-title">
    <div class="aico-page-container aico-preorder2-hero-inner">
      <div class="aico-preorder2-hero-left">
        <h1 id="aico-preorder2-hero-title" class="aico-preorder2-hero-title" data-aico-preorder2-hero-title></h1>
        <p class="aico-preorder2-no-session" data-aico-preorder2-no-session hidden>{{ 'aico_preorder.session.no_active' | t }}</p>
        {%- comment -%} Collection book: explicit labelled download (replaces the old
           b2b-shop affordance of clicking the hero banner image). Hidden until
           preorder2-page.js resolves the session and finds a collectionBookUrl. {%- endcomment -%}
        <a class="aico-preorder2-hero-book" data-aico-preorder2-hero-book href="#" target="_blank" rel="noopener" hidden>
          <svg class="aico-preorder2-hero-book-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span class="aico-preorder2-hero-book-label">{{ 'aico_preorder.session.collection_book' | t }}</span>
        </a>
      </div>

      <div class="aico-preorder2-hero-side">

        <img
          class="aico-preorder2-banner-img"
          data-aico-preorder2-hero-img
          src=""
          alt=""
          loading="eager"
          decoding="async"
          hidden>

        <div class="aico-preorder2-countdown" data-aico-preorder2-countdown role="group"
             aria-label="{{ 'aico_preorder.session.deadline_label' | t }}">
          <p class="aico-preorder2-countdown-eyebrow">{{ 'aico_preorder.session.deadline_label' | t }}</p>
          <div class="aico-preorder2-countdown-bar" role="presentation">
            <div class="aico-preorder2-countdown-segment">
              <span class="aico-preorder2-countdown-value" data-aico-countdown-days>--</span>
              <span class="aico-preorder2-countdown-label">{{ 'aico_preorder.session.deadline_units.days' | t }}</span>
            </div>
            <span class="aico-preorder2-countdown-sep" aria-hidden="true">:</span>
            <div class="aico-preorder2-countdown-segment">
              <span class="aico-preorder2-countdown-value" data-aico-countdown-hours>--</span>
              <span class="aico-preorder2-countdown-label">{{ 'aico_preorder.session.deadline_units.hours' | t }}</span>
            </div>
            <span class="aico-preorder2-countdown-sep" aria-hidden="true">:</span>
            <div class="aico-preorder2-countdown-segment">
              <span class="aico-preorder2-countdown-value" data-aico-countdown-minutes>--</span>
              <span class="aico-preorder2-countdown-label">{{ 'aico_preorder.session.deadline_units.minutes' | t }}</span>
            </div>
            <span class="aico-preorder2-countdown-sep" aria-hidden="true">:</span>
            <div class="aico-preorder2-countdown-segment">
              <span class="aico-preorder2-countdown-value" data-aico-countdown-seconds>--</span>
              <span class="aico-preorder2-countdown-label">{{ 'aico_preorder.session.deadline_units.seconds' | t }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ── Compact filter row ── {%- endcomment -%}
  <section class="aico-preorder2-filters-wrap" aria-labelledby="aico-preorder2-filters-title" data-aico-preorder2-filters-wrap>
    <div class="aico-page-container">
      <h2 id="aico-preorder2-filters-title" class="aico-sr-only">{{ 'aico_preorder.filters.section_aria' | t }}</h2>

      <form class="aico-preorder2-filters"
            data-aico-preorder2-filters
            method="post"
            action="{{ routes.aico_account_preorder_context_url }}"
            autocomplete="off">
        <input type="hidden" name="_token" value="{{ aico_csrf_token }}">

        {%- comment -%} Setup row: billing + delivery (b2b-shop SortFilterControl, no B2B picker). {%- endcomment -%}
        <div class="aico-preorder2-setup-filters" data-aico-preorder2-setup-filters>
        {%- if aico_preorder.is_manager -%}
        <div class="aico-preorder2-field aico-preorder2-field-b2b" data-aico-field="b2b" data-aico-preorder2-b2b-field>
          <span id="aico-preorder2-b2b-label" class="aico-preorder2-field-label">{{ 'aico_preorder.filters.b2b_label' | t }}</span>
          <div class="aico-preorder2-field-control aico-preorder2-field-control-select">
            <svg class="aico-preorder2-field-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 21h18"></path><path d="M5 21V7l8-4v18"></path><path d="M19 21V11l-6-4"></path><path d="M9 9v.01"></path><path d="M9 12v.01"></path><path d="M9 15v.01"></path>
            </svg>
            <div class="aico-preorder2-custom-select aico-preorder2-custom-select-grow" data-aico-custom-select>
              <select name="b2b_id" class="aico-preorder2-select-native" tabindex="-1"
                      aria-labelledby="aico-preorder2-b2b-label" aria-hidden="true"
                      data-aico-preorder2-select="b2b_id" data-aico-preorder2-b2b
                      data-placeholder="{{ 'aico_preorder.filters.b2b_placeholder' | t }}" disabled>
                <option value="">{{ 'aico_preorder.filters.b2b_placeholder' | t }}</option>
              </select>
              <button type="button" id="aico-preorder2-b2b-trigger" class="aico-preorder2-custom-select-trigger"
                      data-aico-custom-select-trigger aria-haspopup="listbox" aria-expanded="false"
                      aria-labelledby="aico-preorder2-b2b-label" disabled>
                <span class="aico-preorder2-custom-select-label" data-aico-custom-select-label></span>
                <svg class="aico-preorder2-custom-select-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="aico-preorder2-custom-select-dropdown" data-aico-custom-select-dropdown hidden>
                <div class="aico-preorder2-b2b-search-wrap">
                  <input type="text" class="aico-preorder2-b2b-search-input" data-aico-preorder2-b2b-search
                         placeholder="{{ 'aico_preorder.filters.b2b_search_placeholder' | t }}" autocomplete="off">
                </div>
                <div role="listbox" class="aico-preorder2-custom-select-list" data-aico-custom-select-list></div>
                {%- comment -%} Footer row shown while the next page of B2Bs is being
                   fetched: the list is paginated and loads on scroll (preorder2-page.js). {%- endcomment -%}
                <div class="aico-preorder2-b2b-more" data-aico-preorder2-b2b-more hidden>
                  <span class="aico-preorder2-b2b-more-spinner" aria-hidden="true"></span>
                  <span>{{ 'aico_preorder.filters.b2b_loading_more' | t }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="aico-preorder2-field aico-preorder2-field-debtor" data-aico-field="debtor" data-aico-preorder2-debtor-field hidden>
          <span id="aico-preorder2-debtor-label" class="aico-preorder2-field-label">{{ 'aico_preorder.filters.debtor_label' | t }}</span>
          <div class="aico-preorder2-field-control aico-preorder2-field-control-select">
            <svg class="aico-preorder2-field-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>
            </svg>
            <div class="aico-preorder2-custom-select aico-preorder2-custom-select-grow" data-aico-custom-select>
              <select name="debtor_id" class="aico-preorder2-select-native" tabindex="-1"
                      aria-labelledby="aico-preorder2-debtor-label" aria-hidden="true"
                      data-aico-preorder2-select="debtor_id" data-aico-preorder2-debtor
                      data-placeholder="{{ 'aico_preorder.filters.debtor_placeholder' | t }}" disabled>
                <option value="">{{ 'aico_preorder.filters.debtor_placeholder' | t }}</option>
              </select>
              <button type="button" id="aico-preorder2-debtor-trigger" class="aico-preorder2-custom-select-trigger"
                      data-aico-custom-select-trigger aria-haspopup="listbox" aria-expanded="false"
                      aria-labelledby="aico-preorder2-debtor-label" disabled>
                <span class="aico-preorder2-custom-select-label" data-aico-custom-select-label></span>
                <svg class="aico-preorder2-custom-select-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="aico-preorder2-custom-select-dropdown" data-aico-custom-select-dropdown hidden>
                <div role="listbox" class="aico-preorder2-custom-select-list" data-aico-custom-select-list></div>
                {%- comment -%} Footer row shown while the next page of B2Bs is being
                   fetched: the list is paginated and loads on scroll (preorder2-page.js). {%- endcomment -%}
                <div class="aico-preorder2-b2b-more" data-aico-preorder2-b2b-more hidden>
                  <span class="aico-preorder2-b2b-more-spinner" aria-hidden="true"></span>
                  <span>{{ 'aico_preorder.filters.b2b_loading_more' | t }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        {%- endif -%}
        <div class="aico-preorder2-field" data-aico-field="billing_address">
          <span id="aico-preorder2-billing-label" class="aico-preorder2-field-label">{{ 'aico_preorder.filters.billing_label' | t }}</span>
