{% comment %}
  Set-a-new-password page — the landing page of the emailed activation /
  reset link (`/set-password?email=…&code=…`). Shopify-shaped template
  name (`customers/reset_password`); the URL and the form action are
  `aico_`-scoped because our link carries `email` + `code` rather than
  Shopify's `/account/reset/{customer_id}/{token}` pair.

  Deliberately independent of the session: the shopper following this
  link has no password yet and may still be signed in as someone else,
  so nothing here reads `customer`.
{% endcomment %}

<div class="aico-auth-shell" style="background-image: var(--aico-auth-bg-image);">
  <div class="aico-auth-overlay" aria-hidden="true"></div>

  <div class="aico-auth-card-wrap">
    <div class="aico-auth-locale-switcher">
      <a href="?locale=en&email={{ request.query.email | url_encode }}&code={{ request.query.code | url_encode }}">EN</a>
      <span aria-hidden="true">·</span>
      <a href="?locale=de_CH&email={{ request.query.email | url_encode }}&code={{ request.query.code | url_encode }}">DE</a>
    </div>

    <div class="aico-auth-card">
      <h1 class="aico-auth-title">{{ 'customer.reset_password.title' | t }}</h1>
      <p class="aico-auth-subtitle">{{ 'customer.reset_password.subtext' | t }}</p>

      {% if request.query.code == blank or request.query.email == blank %}
        <p class="aico-auth-error" role="alert">
          {{ 'customer.reset_password.invalid_token' | t }}
        </p>
        <a href="{{ routes.account_recover_url }}" class="aico-auth-button">
          {{ 'customer.reset_password.request_new_link' | t }}
        </a>
      {% else %}
        {% if form.errors and form.form_type == 'reset_customer_password' %}
          <p class="aico-auth-error" role="alert">
            {% if form.errors contains 'password_mismatch' %}
              {{ 'customer.reset_password.password_mismatch' | t }}
            {% elsif form.errors contains 'weak_password' %}
              {{ 'customer.reset_password.weak_password' | t }}
            {% else %}
              {{ 'customer.reset_password.invalid_token' | t }}
            {% endif %}
          </p>
        {% endif %}

        <form action="{{ routes.aico_set_password_url }}" method="post" class="aico-auth-form">
          <input type="hidden" name="_token" value="{{ aico_csrf_token }}">
          <input type="hidden" name="code" value="{{ request.query.code }}">
          <input type="hidden" name="customer[email]" value="{{ request.query.email }}">

          <label class="aico-auth-field">
            <span class="aico-auth-field-label">{{ 'customer.reset_password.email' | t }}</span>
            <input type="email" value="{{ request.query.email }}" autocomplete="username" disabled>
          </label>

          <label class="aico-auth-field">
            <span class="aico-auth-field-label">{{ 'customer.reset_password.password' | t }}</span>
            <input type="password" name="customer[password]" autocomplete="new-password" minlength="6" required>
          </label>

          <label class="aico-auth-field">
            <span class="aico-auth-field-label">{{ 'customer.reset_password.password_confirm' | t }}</span>
            <input type="password" name="customer[password_confirmation]" autocomplete="new-password" minlength="6" required>
          </label>

          <button type="submit" class="aico-auth-button">
            {{ 'customer.reset_password.submit' | t }}
          </button>
        </form>
      {% endif %}

      <a href="{{ routes.account_login_url }}" class="aico-auth-button aico-auth-button-outline">
        {{ 'customer.reset_password.cancel' | t }}
      </a>
    </div>
  </div>
</div>
