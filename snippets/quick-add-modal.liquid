{% comment %}
  Card quick-add modal bootstrap — rendered ONCE per listing page
  (templates/products.liquid, templates/brand.liquid) after the product
  grid. Emits the config/i18n blob assets/quick-add.js reads and loads the
  script; the modal DOM itself is built by the script on first open (same
  pattern as the production-cockpit reminder modal).

  The modal fetches `routes.aico_quick_add_url` (the LEAN per-product
  variants + stock payload) on open and submits through the shared Alpine cart
  store's bulkUpdate() — the same absolute-quantity path as the PDP size
  matrix — so the header badge, mini-cart and toast all update reactively.

  Two things the payload deliberately does NOT carry, because they are not
  properties of the product, are supplied here instead:
    - the shipping block, which belongs to the SHOPPER
      (`customer.aico_shipping_block`, from the debtor's CRM conditions);
    - the EU → UK/US/MM size labels, which are pure presentation and ship as a
      content-hashed theme asset (assets/size-charts.js) instead of four label
      strings per variant on every request.
{% endcomment %}

{%- comment -%}
  The region tab that starts active is the shopper's account size system
  (customer.aico_size_region, one of EU/UK/US/KR) — same mapping as the PDP
  matrix: KR shares the millimetre chart column, shown as MM.
{%- endcomment -%}
{%- assign aico_quick_add_region = customer.aico_size_region | default: 'EU' -%}
{%- if aico_quick_add_region == 'KR' -%}
  {%- assign aico_quick_add_region = 'MM' -%}
{%- endif -%}
{%- comment -%}
  Same size-chart media as the PDP matrix (theme setting → media-gallery
  file: PDF, image or video). '' when nothing is picked; the script then
  renders no link at all.
{%- endcomment -%}
{%- assign aico_quick_add_size_guide_url = settings.aico_pdp_size_guide_media | aico_media_url -%}

<script id="aico-quick-add-config" type="application/json">{
  "quickAddUrlTemplate": {{ routes.aico_quick_add_url | json }},
  {%- comment -%}
    Legacy fallback: the Shopify-shaped product JSON. quick-add.js only uses it
    when `quickAddUrlTemplate` is empty (theme rendered by a backend without
    the lean route yet) — its payload is a superset, so the modal still works.
  {%- endcomment -%}
  "productJsonUrlTemplate": {{ routes.aico_product_json_url | json }},
  "shippingBlocked": {{ customer.aico_shipping_block | json }},
  "locale": {{ request.locale.iso_code | default: shop.default_locale | json }},
  "sizeRegion": {{ aico_quick_add_region | json }},
  "sizeGuideUrl": {{ aico_quick_add_size_guide_url | default: '' | json }},
  "i18n": {
    "tab_eu": {{ 'product.size_region.tab_eu' | t | json }},
    "tab_uk": {{ 'product.size_region.tab_uk' | t | json }},
    "tab_us": {{ 'product.size_region.tab_us' | t | json }},
    "tab_mm": {{ 'product.size_region.tab_mm' | t | json }},
    "region_aria": {{ 'product.size_region.aria' | t | json }},
    "matrix_aria": {{ 'product.size_matrix.aria' | t | json }},
    "qty_aria": {{ 'product.size_matrix.qty_aria' | t | json }},
    "increase": {{ 'product.size_matrix.increase' | t | json }},
    "decrease": {{ 'product.size_matrix.decrease' | t | json }},
    "total": {{ 'product.size_matrix.total' | t | json }},
    "size_guide": {{ 'product.size_guide.link' | t | json }},
    "size_guide_tooltip": {{ 'product.size_guide.tooltip' | t | json }},
    "add_to_cart": {{ 'product.add_to_cart' | t | json }},
    "update_cart": {{ 'product.update_cart' | t | json }},
    "restricted": {{ 'product.restricted' | t | json }},
    "button_add_hint": {{ 'product.aico_pdp_message.button_add_hint' | t | json }},
    "button_update_hint": {{ 'product.aico_pdp_message.button_update_hint' | t | json }},
    "max_note_label": {{ 'product.aico_pdp_message.max_note_label' | t | json }},
    "max_note_product": {{ 'product.aico_pdp_message.max_note_product' | t | json }},
    "max_note_variant": {{ 'product.aico_pdp_message.max_note_variant' | t | json }},
    "shipping_blocked_hint": {{ 'product.shipping_blocked_hint' | t | json }},
    "close": {{ 'products.quick_add.close' | t | json }},
    "loading": {{ 'products.loading' | t | json }},
    "error": {{ 'products.quick_add.error' | t | json }},
    "sold_out": {{ 'products.quick_add.sold_out' | t | json }},
    "not_quick_addable": {{ 'products.quick_add.not_quick_addable' | t | json }},
    "select_quantity": {{ 'products.quick_add.select_quantity' | t | json }},
    "view_product": {{ 'products.quick_add.view_product' | t | json }},
    "open_aria": {{ 'products.quick_add.open_aria' | t | json }}
  }
}</script>
{%- comment -%}
  Size charts BEFORE quick-add.js: both are deferred, so execution order is
  document order and `window.AICO_SIZE_CHARTS` is set before the modal script
  runs. Missing charts are not fatal — the modal then labels every region with
  the canonical EU value, exactly like the server's own fallback.
{%- endcomment -%}
<script src="{{ 'size-charts.js' | asset_url }}" defer></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer></script>
