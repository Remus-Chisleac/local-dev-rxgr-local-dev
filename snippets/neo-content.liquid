{%- comment -%}
  Portable Neo render unit for content pages (`/pages/<handle>`).

  When the page carries AICO Neo content-builder data (`page.aico_has_neo_content`),
  emit the mount element + the inline page-data JSON; assets/content-builder-neo.js
  finds both on DOMContentLoaded and paints the sections client-side. This is the
  same renderer/engine the news/article Neo path uses (window.NewsNeo). The layout
  scaffold (rows/columns/section grid) comes from content-builder.css; the renderer
  self-injects the per-component CSS (sliders, galleries, lightbox).

  The guard keeps a non-Neo page (or a route that binds no `page` drop) rendering an
  empty mount instead of an empty/broken data script.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'content-builder.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'storefront-neo-blocks.css' | asset_url }}">
<div id="aico-content" class="aico-neo-page"></div>
{%- if page.aico_has_neo_content -%}
  <script>window.current_locale_code = {{ request.locale | default: shop.default_locale | json }};</script>
  {%- comment -%}
    Locale bridge for the client-side storefront renderers
    (assets/storefront-neo-blocks.js) — Liquid `t` isn't reachable from JS.
  {%- endcomment -%}
  <script>window.aicoNeoI18n = {
    "gender_women": {{ 'brand_page.gender_women' | t | json }},
    "gender_men": {{ 'brand_page.gender_men' | t | json }},
    "categories_aria": {{ 'brand_page.categories_aria' | t | json }},
    "news_heading": {{ 'brand_page.news_heading' | t | json }}
  };</script>
  <script id="aico-page-data" type="application/json">{{ page.aico_neo_data }}</script>
  {%- comment -%}
    Server-rendered REAL product cards for the document's product elements —
    the same `product-card` snippet the products listing and old brand page
    use (reviews stars, badges, quick-add button). The client renderer
    (storefront-neo-blocks.js) slots each template's cards into its element's
    place in the painted page, so the cards are byte-identical to the rest of
    the shop. Params mirror the retired brand.liquid featured strip.
  {%- endcomment -%}
  {%- if page.aico_neo_product_slots.size > 0 -%}
    {%- for slot in page.aico_neo_product_slots -%}
      <template data-aico-neo-products="{{ slot.element_id }}">
        {%- for product in slot.products -%}
          {% assign aico_card_eager = false %}
          {% if forloop.index0 < 4 %}{% assign aico_card_eager = true %}{% endif %}
          {% assign aico_quick_add_handle = '' %}
          {% if product.available? %}{% assign aico_quick_add_handle = product.aico_url_handle %}{% endif %}
          <li class="aico-products-grid-item" data-aico-product-id="{{ product.id }}">
            {% render 'product-card',
              url: product.url,
              image: product.featured_image,
              title: product.title,
              sku: product.aico_sku,
              price_label: product.aico_price_label,
              compare_at_label: product.aico_compare_at_price_label,
              rrp_label: product.aico_rrp_label,
              compare_rrp_label: product.aico_compare_rrp_label,
              discount_percent: product.aico_discount_percent,
              on_sale: product.aico_is_on_sale?,
              is_new: product.aico_is_new?,
              discontinued: product.aico_is_discontinued?,
              eager: aico_card_eager,
              show_reviews: true,
              hide_price_on_request: true,
              variant_count: product.aico_variant_count,
            quick_add: aico_quick_add_handle %}
          </li>
        {%- endfor -%}
      </template>
    {%- endfor -%}
    {% render 'yotpo-loader' %}
    {% render 'quick-add-modal' %}
  {%- endif -%}
{%- endif -%}
<script src="{{ 'content-builder-neo.js' | asset_url }}" defer></script>
{%- comment -%}
  Storefront element renderers (hero, product-card/grid/carousel,
  brand-gender-links, brand-news) — registers onto window.NewsNeo, so it must
  load AFTER the engine (defer preserves document order).
{%- endcomment -%}
<script src="{{ 'storefront-neo-blocks.js' | asset_url }}" defer></script>
